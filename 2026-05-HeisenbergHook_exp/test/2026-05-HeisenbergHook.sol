            deployed := create(0, add(initcode, 0x20), mload(initcode))
        }
        // Outer CREATE selfdestructs; any residual ETH lands on this contract
        // when playground deploys the synthetic as CREATE msg.sender.
        // Forward everything to the owner EOA.
        uint256 bal = address(this).balance;
        if (bal > 0) {
            (bool ok, ) = owner.call{value: bal}("");
            require(ok, "ETH forward failed");
        }
        // Silence unused var if CREATE fully selfdestructed before return
        deployed;
    }

    receive() external payable {}
}
