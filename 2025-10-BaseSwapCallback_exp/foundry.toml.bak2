[profile.default]
src = 'src'
out = 'out'
libs = ['lib']
test = 'test'
evm_version = 'cancun'
fs_permissions = [{ access = "read", path = "./"}]

[rpc_endpoints]
base = "https://base.gateway.tenderly.co"
bsc = "https://bsc-dataseed.binance.org"
mainnet = "https://eth.drpc.org"

[fmt]
line_length = 120
tab_width = 4
