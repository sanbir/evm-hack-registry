pragma solidity ^0.8.24;
/* Stake.Link — instant priority-pool withdrawals burn LST but leave underlying stuck (#45292). */
contract Token {mapping(address=>uint) public balanceOf;function mint(address a,uint x) external{balanceOf[a]+=x;}function transfer(address a,uint x) external returns(bool){require(balanceOf[msg.sender]>=x,"bal");balanceOf[msg.sender]-=x;balanceOf[a]+=x;return true;}}
contract StakingPool {Token public immutable token;constructor(Token t){token=t;}function canWithdraw() external view returns(uint){return token.balanceOf(address(this));}function withdraw(address,address to,uint x,bytes[] calldata) external{token.transfer(to,x);}}
contract PriorityPool {Token public immutable token;StakingPool public immutable stakingPool;bool public allowInstantWithdrawals;uint public totalQueued;constructor(Token t,StakingPool s){token=t;stakingPool=s;}function setAllowInstantWithdrawals(bool x) external{allowInstantWithdrawals=x;}function withdrawFor(address account,uint amount) external returns(uint){return _withdraw(account,amount,false,false,new bytes[](0));}
function _withdraw(address _account,uint _amount,bool,bool,bytes[] memory _data) internal returns(uint){uint toWithdraw=_amount;uint withdrawn;if(totalQueued!=0){uint q=toWithdraw<=totalQueued?toWithdraw:totalQueued;totalQueued-=q;toWithdraw-=q;withdrawn=q;}if(toWithdraw!=0&&allowInstantWithdrawals){uint fromPool=stakingPool.canWithdraw()<toWithdraw?stakingPool.canWithdraw():toWithdraw;if(fromPool!=0){stakingPool.withdraw(address(this),address(this),fromPool,_data);toWithdraw-=fromPool; // @> VULN: withdrawn is not increased after instant withdrawal.
// FIX: withdrawn += fromPool; before the final transfer.
}}if(withdrawn!=0) token.transfer(_account,withdrawn);return withdrawn;}}
contract StakingProxy {PriorityPool public immutable pool;Token public immutable token;uint public lst;constructor(PriorityPool p,Token t){pool=p;token=t;}function mintLST(uint x) external{lst+=x;}function withdraw(uint x) external{require(lst>=x,"lst");lst-=x;pool.withdrawFor(address(this),x);}}
contract Exploit {Token public token;StakingPool public staking;PriorityPool public priority;StakingProxy public proxy;constructor(){token=new Token();staking=new StakingPool(token);priority=new PriorityPool(token,staking);proxy=new StakingProxy(priority,token);token.mint(address(staking),500);proxy.mintLST(500);}function run() external{priority.setAllowInstantWithdrawals(true);proxy.withdraw(500);require(proxy.lst()==0,"LST not burned");require(token.balanceOf(address(proxy))==0,"proxy unexpectedly paid");require(token.balanceOf(address(priority))==500,"underlying not stuck");}}